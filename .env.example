# Collaboration server (server/index.ts)
DATABASE_URL=postgres://livedoc:livedoc@127.0.0.1:5432/livedoc
DATABASE_POOL_MAX=10
DOCUMENT_COMPACT_AFTER_UPDATES=100
SHUTDOWN_FLUSH_TIMEOUT_MS=10000
PORT=1234
# HS256 secret for document capability tokens. At least 32 characters.
COLLAB_JWT_SECRET=replace-with-a-long-random-string-32b
COLLAB_TOKEN_TTL_SECONDS=604800
COLLAB_MAX_DOCUMENT_BYTES=2000000
COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=50
COLLAB_MAX_CONNECTIONS_PER_IP=20
COLLAB_MAX_MESSAGES_PER_WINDOW=120
COLLAB_MESSAGE_WINDOW_MS=10000
COLLAB_MAX_WEBSOCKET_PAYLOAD_BYTES=1048576

# Next.js client
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://127.0.0.1:1234
